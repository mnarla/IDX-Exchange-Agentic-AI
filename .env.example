# Database Configuration for OpenClaw Property DB Plugin
# Provide connection details to the local or remote MySQL MLS database.
MYSQL_HOST=localhost
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=idx_exchange

# Embeddings & Vector Search (Week 6)
# Free alternative (recommended): Google Gemini Embeddings (no paid account required)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Week 8 document knowledge (provider/model must match the saved index)
KNOWLEDGE_EMBEDDING_PROVIDER=gemini
KNOWLEDGE_EMBEDDING_MODEL=gemini-embedding-001
# KNOWLEDGE_INDEX_PATH=/absolute/path/to/knowledge/index.json
